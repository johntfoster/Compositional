[Tests]
  design = 'sections/multicomponent_solids.tex'
  issues = ''

  [constitutive_phase_mobility]
    type = CSVDiff
    input = associated_plastic_flow_constitutive_1d.i
    cli_args = 'Outputs/file_base=associated_plastic_flow_constitutive_1d'
    csvdiff = associated_plastic_flow_constitutive_1d.csv
    abs_zero = 1e-12
    rel_err = 1e-11
    requirement = 'The application shall implement the manuscript mapped deviatoric driving stress, single phase-level mobility, associated true-plastic and scalar plastic-distension rates, isochoric trace, and nonnegative dissipation identities.'
  []

  [coupled_evolution]
    type = CSVDiff
    input = associated_plastic_flow_evolution_1d.i
    cli_args = 'Outputs/file_base=associated_plastic_flow_evolution_1d'
    csvdiff = associated_plastic_flow_evolution_1d.csv
    abs_zero = 1e-11
    rel_err = 1e-10
    requirement = 'Selected tensor-component and scalar plastic internal variables shall evolve through independently selectable AD rate kernels with a coupled transient Jacobian and orientation/positivity checks; this reduced component test does not claim exact discrete isochoric preservation.'
  []

  [tensor_distension_and_exact_isochoric_constraint_3d]
    type = CSVDiff
    input = associated_plastic_flow_tensor_evolution_3d.i
    cli_args = 'Outputs/file_base=associated_plastic_flow_tensor_evolution_3d'
    csvdiff = associated_plastic_flow_tensor_evolution_3d.csv
    abs_zero = 1e-11
    rel_err = 1e-10
    requirement = 'A solved three-dimensional system shall retain a composition-dependent AD phase mobility, evolve the generic tensor plastic-distension law, and enforce det(Fbar_p)=1 with a shared multiplier while retaining all nine constrained component-rate rows.'
  []

  [tensor_distension_and_exact_isochoric_constraint_3d_jacobian]
    type = PetscJacobianTester
    input = associated_plastic_flow_tensor_evolution_3d.i
    ratio_tol = 1e-7
    difference_tol = 1e-6
    requirement = 'The solved tensor plastic-deformation/distension system and exact determinant constraint shall retain AD derivatives through a state-dependent phase mobility.'
  []

  [plastic_distension_action_modes_1d]
    type = CSVDiff
    input = plastic_distension_action_modes_1d.i
    cli_args = 'Outputs/file_base=plastic_distension_action_modes_1d'
    csvdiff = plastic_distension_action_modes_1d.csv
    abs_zero = 1e-12
    rel_err = 1e-11
    requirement = 'Input-level Physics/PlasticDistension actions shall independently select and construct the complete tensor or scalar plastic-distension kernel path without source edits.'
  []

  [plastic_distension_action_rejects_mixed_mode]
    type = RunException
    input = plastic_distension_action_modes_1d.i
    cli_args = 'Physics/PlasticDistension/tensor_choice/scalar_variable=ap'
    expect_err = 'Do not provide scalar_variable when mode=tensor'
    requirement = 'The input selector shall reject simultaneous tensor and scalar variables in one plastic-distension physics instance.'
  []

  [plastic_kinematic_hierarchy_mms_2d]
    type = CSVDiff
    input = associated_plastic_flow_kinematic_hierarchy_mms_2d.i
    cli_args = 'Outputs/file_base=associated_plastic_flow_kinematic_hierarchy_mms_2d'
    csvdiff = associated_plastic_flow_kinematic_hierarchy_mms_2d.csv
    abs_zero = 1e-10
    rel_err = 1e-10
    requirement = 'A genuinely tensorial QUAD9/Q2 two-dimensional hierarchy shall reconstruct total, plastic, and elastic distension/true-deformation maps, use a state-dependent phase mobility in the associated flow law, evolve all tensor plastic variables through independently selectable residuals, enforce det(Fbar_p)=1, and audit nonnegative dissipation.'
  []

  [plastic_kinematic_hierarchy_jacobian_2d]
    type = PetscJacobianTester
    input = associated_plastic_flow_kinematic_hierarchy_mms_2d.i
    cli_args = 'Outputs/file_base=associated_plastic_flow_kinematic_hierarchy_jacobian_2d'
    ratio_tol = 2e-6
    difference_tol = 1e-5
    requirement = 'The complete 2D plastic kinematic/constitutive hierarchy shall retain AD derivatives through displacement kinematics, tensor inverses, phase mobility, all plastic evolution rows, and the determinant constraint.'
  []

  [negative_phase_mobility_rejected]
    type = RunException
    input = associated_plastic_flow_constitutive_1d.i
    cli_args = "Materials/mobilities/prop_values='-0.05 0.3'"
    expect_err = 'plastic-deformation phase mobility must remain nonnegative'
    requirement = 'The associated plastic-flow material shall reject a negative state-dependent phase mobility.'
  []

  [nonpositive_tensor_distension_rejected]
    type = RunException
    input = associated_plastic_flow_tensor_evolution_3d.i
    cli_args = 'ICs/Ap00_ic/value=-1'
    expect_err = 'plastic distension tensor must remain orientation preserving'
    requirement = 'The tensor plastic-distension evolution shall reject a non-orientation-preserving internal variable.'
  []

  [nonpositive_elastic_distension_rejected]
    type = RunException
    input = associated_plastic_flow_constitutive_1d.i
    cli_args = "Materials/elastic_distension/tensor_values='-1 0 0  0 1 0  0 0 1'"
    expect_err = 'elastic distension tensor must remain orientation preserving'
    requirement = 'The generic tensor plastic-distension closure shall reject a non-orientation-preserving elastic distension map before applying its inverse.'
  []
[]
