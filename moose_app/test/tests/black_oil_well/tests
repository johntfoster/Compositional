[Tests]
  design = 'moose_app/doc/theory_traceability.yml'
  issues = ''

  [peaceman_bhp_component_sources_1d]
    type = CSVDiff
    input = peaceman_bhp_component_sources_1d.i
    cli_args = 'Outputs/file_base=peaceman_bhp_component_sources_1d'
    csvdiff = peaceman_bhp_component_sources_1d.csv
    abs_zero = 1e-11
    requirement = 'A BHP-controlled Peaceman completion shall convert phase reservoir rates to water, stock-tank oil, and stock-tank gas surface rates and reference component sources with the black-oil B and R_s identifications.'
  []

