[Tests]
  design = 'moose_app/doc/theory_traceability.yml'
  issues = ''

  [charged_nonisothermal_flux_1d]
    type = CSVDiff
    input = charged_nonisothermal_flux_1d.i
    cli_args = 'Outputs/file_base=charged_nonisothermal_flux_1d'
    csvdiff = charged_nonisothermal_flux_1d.csv
    abs_zero = 1e-12
    requirement = 'The application shall compute a one-dimensional electrochemical and thermal component flux from neutral-potential, electric-potential, and temperature gradients, pull it to the solid reference mesh, solve the component balance, and report direct electric-field work on the charge flux.'
  []

  [charged_nonisothermal_nonlinear_flux_1d]
    type = RunCommand
    command = 'python3 ../../../../validation/scripts/check_charged_nonisothermal_nonlinear_flux_mms_1d.py'
    requirement = 'The application shall quantitatively manufacture a one-dimensional charged and nonisothermal component balance with EDGE3/Q2 prescribed solid displacement, P1 plus P0 EG reconstructed neutral, electric, and temperature drivers, a positive spatially nonlinear AD mobility, the current force f_alpha = Grad(mu_neutral_alpha) + z_alpha Grad(phi) + c_T Grad(theta), current flux w_alpha = -L_alpha(X) f_alpha, reference pull-back W_alpha = J F_inverse w_alpha, charge flux, electric work, analytic reference-flux divergence, and a direct solid-reference component-balance residual no larger than 1e-10.'
  []

  [charged_nonisothermal_energy_balance_1d]
    type = RunCommand
    command = 'python3 ../../../../validation/scripts/check_charged_nonisothermal_energy_balance_mms_1d.py'
    requirement = 'The application shall quantitatively manufacture the stationary one-dimensional solid-reference reduction of eq:MC_energy_balance with EDGE3/Q2 prescribed solid displacement; P1 plus P0 EG reconstructed temperature, electric, and neutral drivers; Fourier current heat flux pulled back as Q=J F_inverse q; independently nonzero reference heat-flux divergence, direct relative-current electric work, volumetric heat supply, and both boundary heat-flux values; signed local and global residuals no larger than 1e-10; and invariance under a constant electric-potential gauge shift.'
  []

  [charged_nonisothermal_energy_balance_1d_csv]
    type = CSVDiff
    input = charged_nonisothermal_energy_balance_1d.i
    cli_args = 'Outputs/file_base=charged_nonisothermal_energy_balance_1d'
