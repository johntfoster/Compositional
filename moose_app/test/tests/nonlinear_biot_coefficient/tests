[Tests]
  design = 'moose_app/doc/theory_traceability.yml'
  issues = ''

  [specific_volume_biot_partial_1d]
    type = CSVDiff
    group = 'reduced_only'
    input = specific_volume_biot_partial_1d.i
    cli_args = 'Outputs/file_base=specific_volume_biot_partial_1d'
    csvdiff = specific_volume_biot_partial_1d.csv
    abs_zero = 1e-10
    requirement = 'The application shall compute a nonlinear Biot coefficient from a user-input intrinsic skeleton specific volume using the fixed-equivalent-pressure partial derivative with respect to solid J, matching analytic B, central finite differences, and the fixed-partial result when J and p_E co-vary.'
  []

  [nonlinear_biot_stress_jacobian_1d]
    type = PetscJacobianTester
    group = 'reduced_only'
    input = nonlinear_biot_stress_jacobian_1d.i
    ratio_tol = 1e-7
    difference_tol = 1e-5
    requirement = 'The application shall preserve the AD Jacobian through a state-dependent nonlinear Biot coefficient in a Q2 solid and P1+P0 EG pressure mechanics residual.'
  []

  [small_strain_biot_reduction_1d]
    type = CSVDiff
    group = 'reduced_only'
    input = small_strain_biot_reduction_1d.i
    cli_args = 'Outputs/file_base=small_strain_biot_reduction_1d'
    csvdiff = small_strain_biot_reduction_1d.csv
    abs_zero = 1e-12
    requirement = 'The application shall reduce the nonlinear intrinsic-specific-volume Biot definition to B = 1 - K / K_s in a one-dimensional Q2 solid-reference setup.'
  []

  [small_strain_biot_reduction_2d]
